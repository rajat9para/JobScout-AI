# JobScout v2.1 — Environment Variables
# Copy this file to .env and fill in your actual credentials

# ── Supabase ──
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── Brevo (Sendinblue) Email ──
# Get from: https://app.brevo.com → Settings → SMTP & API → API Keys
# Free tier: 300 emails/day, 9000/month
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender email in Brevo dashboard
SENDER_EMAIL=jobscout@yourdomain.com
SENDER_NAME=JobScout Bot
# Your personal email — receives the nightly PDF digest
USER_EMAIL=your@email.com

# ── Google Gemini (Free Tier) ──
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ── App Settings ──
APP_ENV=production
LOG_LEVEL=INFO
SCRAPE_INTERVAL_MINUTES=60
