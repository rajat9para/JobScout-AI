# JobScout v2 — Environment Variables
# Copy this file to .env and fill in your actual credentials

# ── Supabase ──
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── Twilio ──
# Get from: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox: whatsapp:+14155238886 | Your approved number later
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Your personal WhatsApp number (with country code)
USER_WHATSAPP_NUMBER=+91XXXXXXXXXX

# ── Google Gemini (Free Tier) ──
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ── App Settings ──
APP_ENV=production
LOG_LEVEL=INFO
SCRAPE_INTERVAL_MINUTES=60
