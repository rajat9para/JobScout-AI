# JobScout v2.2 — Environment Variables
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env with real keys to GitHub!

# ── Supabase ──
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ── Brevo (Sendinblue) Email ──
# Get from: https://app.brevo.com → Settings → SMTP & API → API Keys
# Free tier: 300 emails/day, 9000/month
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Verified sender email in Brevo dashboard
SENDER_EMAIL=your-verified-sender@gmail.com
SENDER_NAME=JobScout Bot
# Your personal email — receives the PDF digests
USER_EMAIL=your@email.com

# ── Google Gemini (Free Tier) ──
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# ── App Settings ──
APP_ENV=production
LOG_LEVEL=INFO
SCRAPE_INTERVAL_MINUTES=60
