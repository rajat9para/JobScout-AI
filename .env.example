# JobScout v2.2 — Environment Variables Template

# ── Supabase ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Brevo (Sendinblue) Email ──
BREVO_API_KEY=xkeysib-your_brevo_api_key
SENDER_EMAIL=your_verified_sender@gmail.com
SENDER_NAME=JobScout Bot
USER_EMAIL=your_email@gmail.com

# ── Groq AI Dual Agents (Ultra-Fast LPU Inference) ──
GROQ_API_KEY=gsk_your_primary_groq_key
GROQ_JOB_INTELLIGENCE_API_KEY=gsk_your_job_intelligence_key
GROQ_JOB_REALITY_API_KEY=gsk_your_job_reality_research_key
GROQ_MODEL=openai/gpt-oss-120b
JOB_REALITY_RESEARCH_LIMIT=10

# ── App Settings ──
APP_ENV=production
LOG_LEVEL=INFO
SCRAPE_INTERVAL_MINUTES=60
